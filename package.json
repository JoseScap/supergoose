{
  "name": "supergoose",
  "private": true,
  "version": "0.0.1",
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test --import tsx packages/*/test/*.test.ts",
    "test:coverage": "c8 --check-coverage --lines 90 --statements 90 --branches 75 --functions 80 --reporter=text --reporter=lcov --reporter=html node --test --import tsx packages/*/test/*.test.ts",
    "coverage": "npm run test:coverage",
    "dev": "npm run dev --workspace supergoose-api",
    "build": "npm run build --workspace supergoose-core && npm run build --workspace supergoose-infra && npm run build --workspace supergoose-api",
    "start": "npm run start --workspace supergoose-api",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "c8": "^12.0.0",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
